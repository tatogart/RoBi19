{
  "name": "robis",
  "version": "1.0.0",
  "description": "Robis — a 2019-era Roblox-style game platform: website, multiplayer 3D client, Lua scripting and Robis Studio.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed": "node server/seed/reset.js",
    "reset-password": "node server/seed/reset-password.js",
    "build:standalone": "node scripts/build-standalone.mjs",
    "test": "node --test \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "codemirror": "^5.65.21",
    "express": "^5.2.1",
    "fengari": "^0.1.5",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
